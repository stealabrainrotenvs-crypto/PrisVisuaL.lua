-- Toggle Component
local function createToggle(parent, name, yPos, callback)
	local container = Instance.new("Frame")
	container.Size = UDim2.new(1, 0, 0, 28)
	container.Position = UDim2.new(0, 0, 0, yPos)
	container.BackgroundColor3 = Color3.fromRGB(26, 14, 14)
	container.Parent = parent

	local c = Instance.new("UICorner")
	c.CornerRadius = UDim.new(0, 6)
	c.Parent = container

	local label = Instance.new("TextLabel")
	label.Size = UDim2.new(1, -50, 1, 0)
	label.Position = UDim2.new(0, 8, 0, 0)
	label.BackgroundTransparency = 1
	label.Text = name
	label.TextColor3 = Color3.fromRGB(200, 180, 180)
	label.TextSize = 12
	label.TextXAlignment = Enum.TextXAlignment.Left
	label.Font = ARCADE_FONT
	label.Parent = container

	local switchBg = Instance.new("Frame")
	switchBg.Size = UDim2.new(0, 36, 0, 16)
	switchBg.Position = UDim2.new(1, -42, 0.5, -8)
	switchBg.BackgroundColor3 = Color3.fromRGB(35, 20, 20)
	switchBg.Parent = container

	local sc = Instance.new("UICorner")
	sc.CornerRadius = UDim.new(1, 0)
	sc.Parent = switchBg

	local switchDot = Instance.new("Frame")
	switchDot.Size = UDim2.new(0, 12, 0, 12)
	switchDot.Position = UDim2.new(0, 2, 0.5, -6)
	switchDot.BackgroundColor3 = Color3.fromRGB(231, 76, 60)
	switchDot.Parent = switchBg

	local dc = Instance.new("UICorner")
	dc.CornerRadius = UDim.new(1, 0)
	dc.Parent = switchDot

	local clickBtn = Instance.new("TextButton")
	clickBtn.Size = UDim2.new(1, 0, 1, 0)
	clickBtn.BackgroundTransparency = 1
	clickBtn.Text = ""
	clickBtn.Parent = container

	local state = false
	clickBtn.MouseButton1Click:Connect(function()
		state = not state
		if state then
			TweenService:Create(switchDot, TweenInfo.new(0.2), {
				Position = UDim2.new(1, -14, 0.5, -6),
				BackgroundColor3 = Color3.fromRGB(46, 204, 113)
			}):Play()
		else
			TweenService:Create(switchDot, TweenInfo.new(0.2), {
				Position = UDim2.new(0, 2, 0.5, -6),
				BackgroundColor3 = Color3.fromRGB(231, 76, 60)
			}):Play()
		end
		callback(state)
	end)
end

